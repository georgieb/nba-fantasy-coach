# Backend settings. Users enter their own ESPN league, cookies and Anthropic key in the app (Profile page).

# Supabase (accounts). Leave blank to run guest-only (mock drafts, no saved data).
# Local dev: run `supabase start` and copy values from `supabase status -o env`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # service_role / secret key - server only, never expose to the browser
SUPABASE_JWT_SECRET=                # only needed for HS256 projects (local dev / legacy JWT secret)
APP_ENCRYPTION_KEY=                 # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

ESPN_YEAR=2027                      # default season (2026-27 = 2027)
CLAUDE_MODEL=claude-opus-5-5        # default model when a user doesn't pick one
POLL_SECONDS=3
SHARE_SERVER_KEY=false              # true = users without a key use ANTHROPIC_API_KEY below (you pay)
ANTHROPIC_API_KEY=
